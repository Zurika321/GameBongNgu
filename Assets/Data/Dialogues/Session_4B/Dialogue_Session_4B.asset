  sessionId: 4B
  npcName: "\xC9n"
  nodes:
  - text: "T\xF4i s\u1EBD canh cho t\u1EDBi s\xE1ng. D\xF9 c\xF3 chuy\u1EC7n g\xEC,
      t\xF4i c\u0169ng kh\xF4ng m\u1EDF c\u1EEDa \u0111\xE2u."
    nextNodeIndex: -1
    choices:
    - sessionId: 4B
      choiceId: 4B1
      label: "T\u1EF1 tr\xF3i m\xECnh trong kho"
      requiredFlag: 
      resultText: "Kh\u1EA3i t\u1EF1 kh\xF3a c\u1EEDa kho. Ti\u1EBFng b\u01B0\u1EDBc
        ch\xE2n c\u1EE7a \xC9n v\u1EABn \u0111\u1EC1u \u0111\u1EB7n \u1EDF ph\xEDa
        b\xEAn kia."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
    - sessionId: 4B
      choiceId: 4B2
      label: "Nh\u1EDD \xC9n canh b\xEAn ngo\xE0i"
      requiredFlag: 
      resultText: "\xC9n nh\u1EADn l\u1EDDi \u0111\u1EE9ng g\xE1c. Kh\u1EA3i bi\u1EBFt
        quy\u1EBFt \u0111\u1ECBnh n\xE0y c\xF3 th\u1EC3 \u0111\u1EB7t ng\u01B0\u1EDDi
        b\u1EA1n c\u1EE7a m\xECnh v\xE0o nguy hi\u1EC3m."
      nextNodeIndex: -1
      ltDelta: 1
      qtDelta: 0
