  m_Script: {fileID: 11500000, guid: 40ed51c39cfc83d4c968c32f57874512, type: 3}
  m_Name: Dialogue_Session_3
  m_EditorClassIdentifier: Assembly-CSharp::DemoDialogueAsset
  sessionId: 3
  npcName: "Th\u1EA7y H\u1EA1o"
  nodes:
  - text: "Ta c\xF3 th\u1EC3 kh\xF3a n\xF3 l\u1EA1i m\u1ED7i \u0111\xEAm, nh\u01B0ng
      c\xE1i gi\xE1 l\xE0 m\u1ED9t m\u1EA3nh k\xFD \u1EE9c c\u1EE7a con. Con ch\u1ECBu
      kh\xF4ng?"
    nextNodeIndex: -1
    choices:
    - sessionId: 3
      choiceId: 3A
      label: "Nh\u1EADn b\xF9a kh\xF3a qu\u1EF7"
      requiredFlag: 
      resultText: "H\u1EA1o bu\u1ED9c l\xE1 b\xF9a v\xE0o c\u1ED5 tay Kh\u1EA3i.
        M\u1ED9t k\xFD \u1EE9c tu\u1ED5i th\u01A1 nh\u1EA1t d\u1EA7n, \u0111\u1ED5i
        l\u1EA1i b\xF3ng t\u1ED1i b\u1ECB gh\xECm xu\u1ED1ng."
      nextNodeIndex: -1
      ltDelta: 2
      qtDelta: -1
    - sessionId: 3
      choiceId: 3B
      label: "T\u1EEB ch\u1ED1i b\xF9a"
      requiredFlag: 
      resultText: "Kh\u1EA3i t\u1EEB ch\u1ED1i \u0111\u1EC3 ng\u01B0\u1EDDi kh\xE1c
        quy\u1EBFt \u0111\u1ECBnh m\xECnh ph\u1EA3i qu\xEAn \u0111i\u1EC1u g\xEC.
        H\u1EA1o l\u1EB7ng l\u1EBD c\u1EA5t l\xE1 b\xF9a \u0111i."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 1
