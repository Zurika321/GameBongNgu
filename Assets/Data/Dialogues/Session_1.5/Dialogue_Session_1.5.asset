  m_Script: {fileID: 11500000, guid: 40ed51c39cfc83d4c968c32f57874512, type: 3}
  m_Name: Dialogue_Session_1.5
  m_EditorClassIdentifier: Assembly-CSharp::DemoDialogueAsset
  sessionId: 1.5
  npcName: "Kh\u1EA3i"
  postDialogueText: 
  nodes:
  - speakerId: player
    text: "L\u0169 chu\u1ED9t \u0111\xE3 ch\u1EBFt. Kh\u1EA3i l\u1EADt x\xE1c nh\xECn:
      m\u1ED9t d\xE2n qu\xE2n tr\u1EBB, tay \u0111eo v\xF2ng v\u1EA3i c\u1EE7a l\xE0ng,
      ng\u1EF1c c\xF3 v\u1EBFt c\u1EAFt. Anh kh\xF4ng nh\u1EDB g\xEC."
    nextNodeIndex: -1
    choices:
    - sessionId: 1.5
      choiceId: 1A
      label: "Ch\xF4n x\xE1c, im l\u1EB7ng r\u1EDDi \u0111i"
      requiredFlag: 
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i ch\xF4n Ti\u1EC3u B\u1EA3y v\xE0 r\u1EDDi c\u0103n nh\xE0.
        M\u1EA3nh gi\u1EA5y trong t\xFAi \xE1o v\u1EABn ch\u01B0a \u0111\u01B0\u1EE3c
        \u0111\u1ECDc."
      resultSpeakerId: player
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 1
    - sessionId: 1.5
      choiceId: 1B
      label: "L\u1EE5c so\xE1t x\xE1c ch\u1EBFt"
      requiredFlag: 
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Trong t\xFAi x\xE1c c\xF3 m\u1EA3nh gi\u1EA5y v\u1EBD c\u1EA7u
        thang l\xEAn g\xE1c m\xE1i, ghi: \u2018C\u1EADu B\u1EA3y, \u0111\u1EEBng
        \u0111i m\u1ED9t m\xECnh.\u2019 Kh\u1EA3i nh\u1EADn ra ng\u01B0\u1EDDi ch\u1EBFt
        l\xE0 Ti\u1EC3u B\u1EA3y."
      resultSpeakerId: player
      nextNodeIndex: -1
      ltDelta: 1
      qtDelta: 0
