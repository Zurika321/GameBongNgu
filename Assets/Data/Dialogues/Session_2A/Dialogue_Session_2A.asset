  sessionId: 2A
  npcName: "Tr\u01B0\u1EDFng L\xE0ng T\u1EE9"
  nodes:
  - text: "M\xE1u tr\xEAn \xE1o ng\u01B0\u01A1i l\xE0 c\u1EE7a ai? N\xF3i th\u1EADt,
      ta s\u1EBD tha."
    nextNodeIndex: -1
    choices:
    - sessionId: 2A
      choiceId: 2A1
      label: "N\xF3i d\u1ED1i: \u0111\xF3 kh\xF4ng ph\u1EA3i m\xE1u ng\u01B0\u1EDDi"
      requiredFlag: 
      resultText: "T\u1EE9 kh\xF4ng tin l\u1EDDi Kh\u1EA3i. \xD4ng ra hi\u1EC7u cho
        d\xE2n qu\xE2n tr\xE1nh \u0111\u01B0\u1EDDng, nh\u01B0ng v\u1EABn d\u1EB7n
        m\u1ECDi ng\u01B0\u1EDDi \u0111\u1EC3 m\u1EAFt \u0111\u1EBFn anh."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 1
    - sessionId: 2A
      choiceId: 2A2
      label: "Th\xFA nh\u1EADn m\u1ED9t ph\u1EA7n s\u1EF1 th\u1EADt"
      requiredFlag: 
      resultText: "T\u1EE9 h\u1EA1 th\u1EA5p ng\u1ECDn \u0111u\u1ED1c. \xD4ng c\u1EA3nh
        b\xE1o Kh\u1EA3i r\u1EB1ng d\xE2n l\xE0ng s\u1EBD kh\xF4ng tha th\u1EE9 n\u1EBFu
        c\xF3 th\xEAm ng\u01B0\u1EDDi b\u1ECB h\u1EA1i."
      nextNodeIndex: -1
      ltDelta: 1
      qtDelta: 0
