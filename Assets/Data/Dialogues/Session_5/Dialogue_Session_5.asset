  sessionId: 5
  npcName: "B\xE0 T\u01B0 B\xE1n Thu\u1ED1c"
  nodes:
  - text: "C\u1EADu m\xE0 \u0111\xE1nh lui \u0111\u01B0\u1EE3c l\u0169 qu\xE1i \u0111\xEAm
      nay, c\u1EA3 th\u1ECB tr\u1EA5n n\xE0y mang \u01A1n c\u1EADu su\u1ED1t \u0111\u1EDDi."
    nextNodeIndex: -1
    choices:
    - sessionId: 5
      choiceId: 5A
      label: "\u1EDE l\u1EA1i b\u1EA3o v\u1EC7 th\u1ECB tr\u1EA5n"
      requiredFlag: 
      resultText: "B\xE0 T\u01B0 trao cho Kh\u1EA3i thu\u1ED1c men c\xF2n l\u1EA1i.
        C\u1EA3 th\u1ECB tr\u1EA5n chu\u1EA9n b\u1ECB cho m\u1ED9t \u0111\xEAm d\xE0i."
      nextNodeIndex: -1
      ltDelta: 1
      qtDelta: 0
    - sessionId: 5
      choiceId: 5B
      label: "R\u1EDDi th\u1ECB tr\u1EA5n tr\u01B0\u1EDBc khi tr\u1EDDi t\u1ED1i"
      requiredFlag: 
      resultText: "Kh\u1EA3i l\u1EB7ng l\u1EBD r\u1EDDi c\u1ED5ng ch\u1EE3. Ti\u1EBFng
        chu\xF4ng b\xE1o \u0111\u1ED9ng v\u1EABn vang l\xEAn sau l\u01B0ng."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 1
