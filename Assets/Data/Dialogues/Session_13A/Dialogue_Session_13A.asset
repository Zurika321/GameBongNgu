  m_Script: {fileID: 11500000, guid: 40ed51c39cfc83d4c968c32f57874512, type: 3}
  m_Name: Dialogue_Session_13A
  m_EditorClassIdentifier: Assembly-CSharp::DemoDialogueAsset
  sessionId: 13A
  npcName: Nhi
  nodes:
  - text: "\u0110\u1EC3 t\xF4i c\xF9ng g\xE1nh v\u1EDBi anh. Anh kh\xF4ng c\u1EA7n
      ph\u1EA3i bi\u1EBFn m\u1EA5t m\u1ED9t m\xECnh."
    nextNodeIndex: -1
    choices:
    - sessionId: 13A
      choiceId: 13A_Hy
      label: "T\u1EF1 nguy\u1EC7n hy sinh"
      requiredFlag: NhiTrust
      resultText: "Kh\u1EA3i b\u01B0\u1EDBc v\xE0o v\xF2ng s\xE1ng m\u1ED9t m\xECnh,
        ch\u1EA5p nh\u1EADn c\xE1i gi\xE1 cu\u1ED1i c\xF9ng \u0111\u1EC3 gi\u1EA3i
        tho\xE1t nh\u1EEFng ng\u01B0\u1EDDi c\xF2n l\u1EA1i."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
    - sessionId: 13A
      choiceId: 13A_Nhi
      label: "\u0110\u1EC3 Nhi c\xF9ng g\xE1nh"
      requiredFlag: 
      resultText: "Nhi n\u1EAFm l\u1EA5y tay Kh\u1EA3i. Nh\u1EEFng ng\u01B0\u1EDDi
        c\xF2n l\u1EA1i c\xF9ng gi\u1EEF v\xF2ng nghi l\u1EC5 \u1ED5n \u0111\u1ECBnh."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
    - sessionId: 13A
      choiceId: 13A_Tram
      label: "D\xF9ng Tr\xE2m C\xE0i l\xE0m v\u1EADt d\u1EABn, c\u1EA3 hai g\xE1nh
        nh\u1EB9 h\u01A1n"
      requiredFlag: HasTram
      resultText: "Tr\xE2m C\xE0i ph\xE1t s\xE1ng trong v\xF2ng nghi l\u1EC5. Nhi
        c\xF9ng Kh\u1EA3i gi\u1EEF l\u1EA5y ph\u1EA7n s\u1EE9c n\u1EB7ng c\xF2n l\u1EA1i."
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
