    choices: []
  - speakerId: 
    text: "Tr\u01B0\u1EDFng l\xE0ng nh\xECn th\u1EB3ng v\xE0o m\u1EAFt b\u1EA1n,
      ch\u1EDD m\u1ED9t c\xE2u tr\u1EA3 l\u1EDDi."
    nextNodeIndex: -1
    choices:
    - sessionId: 2A
      choiceId: A1
      label: "N\xF3i d\u1ED1i: T\xF4i kh\xF4ng th\u1EA5y g\xEC c\u1EA3."
      requiredFlag: Session2AReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "T\u1EE9 im l\u1EB7ng m\u1ED9t l\xFAc r\u1ED3i g\u1EADt \u0111\u1EA7u.
        \"N\u1EBFu con ch\u1EAFc ch\u1EAFn, ta s\u1EBD tin con. Nh\u01B0ng h\xE3y
        tr\xE1nh xa c\u0103n nh\xE0 \u1EA5y.\""
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: -1
      qtDelta: 1
    - sessionId: 2A
      choiceId: A2
      label: "Th\xFA nh\u1EADn: T\xF4i \u0111\xE3 t\xECm th\u1EA5y nh\u1EADt k\xFD."
      requiredFlag: Session2AReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "T\u1EE9 \u0111\u1ECDc nh\u1EEFng d\xF2ng \u0111\u1EA7u ti\xEAn,
        g\u01B0\u01A1ng m\u1EB7t n\u1EB7ng tr\u0129u. \"C\u1EA3m \u01A1n con \u0111\xE3
        n\xF3i th\u1EADt. Ta s\u1EBD gi\xFAp con t\xECm hi\u1EC3u chuy\u1EC7n n\xE0y.\""
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: -1
  - speakerId: 
    text: "Tr\u01B0\u1EDFng l\xE0ng nh\u1EAFc b\u1EA1n h\xE3y chu\u1EA9n b\u1ECB
      k\u1EF9 tr\u01B0\u1EDBc khi \u0111i s\xE2u h\u01A1n v\xE0o v\xF9ng t\u1ED1i."
    nextNodeIndex: -1
    choices: []
