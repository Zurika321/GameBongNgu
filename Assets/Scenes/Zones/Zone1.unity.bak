--- !u!114 &2085286106
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2085286105}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  interactionRange: 2.25
  dialogueAsset: {fileID: 0}
  dialogue:
  - speakerId: 
    text: "Trong h\xE0nh lang g\u01B0\u01A1ng, gi\u1ECDng n\xF3i kh\xF4ng h\xECnh
      h\xE0i vang l\xEAn: \u201CNg\u01B0\u01A1i ngh\u0129 kh\xF3a \u0111\u01B0\u1EE3c
      ta sao? Ta ch\u1EC9 \u0111ang... ngh\u1EC9 ng\u01A1i.\u201D"
    nextNodeIndex: 1
    choices: []
  - speakerId: 
    text: "Kh\u1EA3i c\xF3 th\u1EC3 l\u1EAFng nghe V\xF4 Di\u1EC7n ho\u1EB7c ch\u1ED1ng
      l\u1EA1i gi\u1ECDng n\xF3i c\u1EE7a n\xF3."
    nextNodeIndex: -1
    choices:
    - sessionId: 4A
      choiceId: A
      label: "L\u1EAFng nghe V\xF4 Di\u1EC7n."
      requiredFlag: Session4AReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i l\u1EAFng nghe ti\u1EBFng th\xEC th\u1EA7m. V\xF4 Di\u1EC7n
        ti\u1EBFt l\u1ED9 m\u1ED9t ph\u1EA7n v\u1EC1 v\xF2ng l\u1EB7p chi\u1EBFm
        x\xE1c."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 1
    - sessionId: 4A
      choiceId: B
      label: "Ph\u1EDBt l\u1EDD v\xE0 ch\u1ED1ng l\u1EA1i."
      requiredFlag: Session4AReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i quay l\u01B0ng v\u1EDBi nh\u1EEFng t\u1EA5m g\u01B0\u01A1ng
        v\xE0 kh\xE1ng c\u1EF1 gi\u1ECDng n\xF3i."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: 0
  - speakerId: 
    text: "Kh\u1EA3i bi\u1EBFt l\u1EF1a ch\u1ECDn n\xE0y s\u1EBD thay \u0111\u1ED5i
      con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc."
    nextNodeIndex: -1
    choices: []
