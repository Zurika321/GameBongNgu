--- !u!114 &1187601019
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1187601018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  interactionRange: 2.25
  dialogueAsset: {fileID: 0}
  dialogue:
  - speakerId: 
    text: "B\xE0 T\u01B0 nh\xECn qua c\u1ED5ng ch\u1EE3 \u0111ang rung l\xEAn v\xEC
      ti\u1EBFng g\xE0o: \u201CC\u1EADu l\xE0 th\u1EE3 s\u0103n ph\u1EA3i kh\xF4ng?
      C\u1EA3 th\u1ECB tr\u1EA5n \u0111ang c\u1EA7n gi\xFAp.\u201D"
    nextNodeIndex: 1
    choices: []
  - speakerId: 
    text: "Kh\u1EA3i s\u1EBD c\xF4ng khai gi\xFAp th\u1ECB tr\u1EA5n ch\u1ED1ng qu\xE1i
      \u0111\xEAm nay, hay \xE2m th\u1EA7m r\u1EDDi \u0111i \u0111\u1EC3 tr\xE1nh
      g\xE2y h\u1ECDa?"
    nextNodeIndex: -1
    choices:
    - sessionId: 5
      choiceId: A
      label: "Nh\u1EADn l\u1EDDi gi\xFAp th\u1ECB tr\u1EA5n."
      requiredFlag: Session5Ready
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i b\u01B0\u1EDBc ra qu\u1EA3ng tr\u01B0\u1EDDng b\u1EA3o
        v\u1EC7 d\xE2n l\xE0ng. M\u1ECDi ng\u01B0\u1EDDi bi\u1EBFt \u01A1n ng\u01B0\u1EDDi
        th\u1EE3 s\u0103n \u0111\xE3 \u1EDF l\u1EA1i."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: 0
    - sessionId: 5
      choiceId: B
      label: "T\u1EEB ch\u1ED1i v\xE0 \xE2m th\u1EA7m r\u1EDDi \u0111i."
      requiredFlag: Session5Ready
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i r\u1EDDi th\u1ECB tr\u1EA5n trong b\xF3ng t\u1ED1i,
        s\u1EE3 l\u1EDDi nguy\u1EC1n s\u1EBD khi\u1EBFn m\xECnh l\xE0m h\u1EA1i ng\u01B0\u1EDDi
        v\xF4 t\u1ED9i."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 1
  - speakerId: 
    text: "Kh\u1EA3i bi\u1EBFt l\u1EF1a ch\u1ECDn n\xE0y s\u1EBD thay \u0111\u1ED5i
      con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc."
    nextNodeIndex: -1
    choices: []
