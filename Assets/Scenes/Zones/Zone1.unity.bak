--- !u!114 &91995324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 91995323}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  interactionRange: 2.25
  dialogueAsset: {fileID: 0}
  dialogue:
  - speakerId: 
    text: "Kh\u1EA3i m\u1EDF cu\u1ED1n nh\u1EADt k\xFD. Nh\u1EEFng d\xF2ng ch\u1EEF
      nh\u1EAFc \u0111\u1EBFn V\xF4 Di\u1EC7n v\xE0 l\u1EDDi nguy\u1EC1n Song Mi\xEAn.
      \u201CM\xECnh n\xEAn \u0111\u1ECDc ti\u1EBFp \u0111\u1EC3 t\xECm hi\u1EC3u
      s\u1EF1 th\u1EADt, hay \u0111\u1ED1t cu\u1ED1n s\u1ED5 n\xE0y \u0111i?\u201D"
    nextNodeIndex: 1
    choices: []
  - speakerId: 
    text: "Kh\u1EA3i t\u1EF1 h\u1ECFi: \u201C\u0110\u1ECDc cu\u1ED1n nh\u1EADt k\xFD,
      hay \u0111\u1ED1t n\xF3?\u201D"
    nextNodeIndex: -1
    choices:
    - sessionId: 2B
      choiceId: B1
      label: "\u0110\u1ECDc cu\u1ED1n nh\u1EADt k\xFD."
      requiredFlag: AtticChestOpened
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i quy\u1EBFt \u0111\u1ECBnh \u0111\u1ECDc. Nh\u1EEFng
        d\xF2ng ch\u1EEF h\xE9 l\u1ED9 m\u1ED9t ph\u1EA7n b\xED m\u1EADt v\u1EC1
        V\xF4 Di\u1EC7n."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: 0
    - sessionId: 2B
      choiceId: B2
      label: "\u0110\u1ED1t cu\u1ED1n nh\u1EADt k\xFD."
      requiredFlag: AtticChestOpened
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i quy\u1EBFt \u0111\u1ECBnh \u0111\u1ED1t cu\u1ED1n s\u1ED5.
        Anh kh\xF4ng mu\u1ED1n bi\u1EBFt th\xEAm v\u1EC1 th\u1EE9 \u0111ang \xE1m
        m\xECnh."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 1
  - speakerId: 
    text: "Kh\u1EA3i bi\u1EBFt l\u1EF1a ch\u1ECDn n\xE0y s\u1EBD thay \u0111\u1ED5i
      con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc."
    nextNodeIndex: -1
    choices: []
