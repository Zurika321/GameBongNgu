--- !u!114 &501062016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 501062015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  interactionRange: 2.25
  dialogueAsset: {fileID: 0}
  dialogue:
  - speakerId: 
    text: "\xC9n \u0111\u1EE9ng ngo\xE0i c\u1EEDa kho \u0111\xE1, \xF4m ng\u1ECDn
      \u0111u\u1ED1c: \u201CN\u1EBFu c\u1EADu c\u1EA7n, t\xF4i s\u1EBD canh t\u1EDBi
      s\xE1ng. T\xF4i s\u1EBD kh\xF4ng m\u1EDF c\u1EEDa d\xF9 c\xF3 chuy\u1EC7n g\xEC.\u201D"
    nextNodeIndex: 1
    choices: []
  - speakerId: 
    text: "Kh\u1EA3i quy\u1EBFt \u0111\u1ECBnh t\u1EF1 tr\xF3i m\xECnh m\u1ED9t m\xECnh
      hay nh\u1EDD \xC9n \u1EDF l\u1EA1i canh gi\u1EEF."
    nextNodeIndex: -1
    choices:
    - sessionId: 4B
      choiceId: A
      label: "T\u1EF1 tr\xF3i m\xECnh \u1EDF n\u01A1i hoang v\u1EAFng."
      requiredFlag: Session4BReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "Kh\u1EA3i t\u1EF1 kh\xF3a c\u1EEDa kho \u0111\xE1 t\u1EEB b\xEAn
        trong, kh\xF4ng \u0111\u1EC3 ai ph\u1EA3i g\xE1nh nguy hi\u1EC3m thay m\xECnh."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 0
    - sessionId: 4B
      choiceId: B
      label: "Nh\u1EDD \xC9n canh gi\u1EEF."
      requiredFlag: Session4BReady
      requiredItemName: 
      requiredItemAmount: 1
      resultText: "\xC9n \u0111\u1ED3ng \xFD \u1EDF l\u1EA1i. Kh\u1EA3i \u0111\u01B0\u1EE3c
        an to\xE0n h\u01A1n, nh\u01B0ng ng\u01B0\u1EDDi b\u1EA1n c\u1EE7a anh c\xF3
        th\u1EC3 g\u1EB7p nguy hi\u1EC3m."
      resultSpeakerId: 
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: 0
  - speakerId: 
    text: "Kh\u1EA3i bi\u1EBFt l\u1EF1a ch\u1ECDn n\xE0y s\u1EBD thay \u0111\u1ED5i
      con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc."
    nextNodeIndex: -1
    choices: []
