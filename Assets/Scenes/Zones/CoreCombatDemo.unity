--- !u!114 &1599244394
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1599244393}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  npcName: "Tr\u01B0\u1EDFng L\xE0ng T\u1EE9"
  portraitFrames:
  - {fileID: 21300000, guid: bdaa38f00ae60c64e82c5bca5dc60a5c, type: 3}
  portraitFrameRate: 4
  dialogue:
  - text: "Ta l\xE0 T\u1EE9, ng\u01B0\u1EDDi tr\xF4ng coi ng\xF4i l\xE0ng ven s\xF4ng.
      \u0110\xEAm qua c\xF3 ti\u1EBFng \u0111\u1ED9ng t\u1EEB c\u0103n nh\xE0 hoang
      ph\xEDa b\u1EAFc. Con \u0111\xE3 th\u1EA5y chuy\u1EC7n g\xEC \u1EDF \u0111\xF3?
      H\xE3y suy ngh\u0129 k\u1EF9 tr\u01B0\u1EDBc khi tr\u1EA3 l\u1EDDi."
    nextNodeIndex: 1
    choices: []
  - text: "Tr\u01B0\u1EDFng l\xE0ng nh\xECn th\u1EB3ng v\xE0o m\u1EAFt b\u1EA1n,
      ch\u1EDD m\u1ED9t c\xE2u tr\u1EA3 l\u1EDDi."
    nextNodeIndex: -1
    choices:
    - sessionId: 2A
      choiceId: A1
      label: "N\xF3i d\u1ED1i: T\xF4i kh\xF4ng th\u1EA5y g\xEC c\u1EA3."
      requiredFlag: Session2AReady
      resultText: "T\u1EE9 im l\u1EB7ng m\u1ED9t l\xFAc r\u1ED3i g\u1EADt \u0111\u1EA7u.
        \"N\u1EBFu con ch\u1EAFc ch\u1EAFn, ta s\u1EBD tin con. Nh\u01B0ng h\xE3y
        tr\xE1nh xa c\u0103n nh\xE0 \u1EA5y.\""
      nextNodeIndex: 2
      ltDelta: -1
      qtDelta: 1
    - sessionId: 2A
      choiceId: A2
      label: "Th\xFA nh\u1EADn: T\xF4i \u0111\xE3 t\xECm th\u1EA5y nh\u1EADt k\xFD."
      requiredFlag: Session2AReady
      resultText: "T\u1EE9 \u0111\u1ECDc nh\u1EEFng d\xF2ng \u0111\u1EA7u ti\xEAn,
        g\u01B0\u01A1ng m\u1EB7t n\u1EB7ng tr\u0129u. \"C\u1EA3m \u01A1n con \u0111\xE3
        n\xF3i th\u1EADt. Ta s\u1EBD gi\xFAp con t\xECm hi\u1EC3u chuy\u1EC7n n\xE0y.\""
      nextNodeIndex: 2
      ltDelta: 1
      qtDelta: -1
  - text: "Tr\u01B0\u1EDFng l\xE0ng nh\u1EAFc b\u1EA1n h\xE3y chu\u1EA9n b\u1ECB
      k\u1EF9 tr\u01B0\u1EDBc khi \u0111i s\xE2u h\u01A1n v\xE0o v\xF9ng t\u1ED1i."
    nextNodeIndex: -1
    choices: []
