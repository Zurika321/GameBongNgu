--- !u!114 &100175510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100175507}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  npcName: "Th\u1EA7y Tr\u1EEB T\xE0 H\u1EA1o"
  portraitFrames:
  - {fileID: 21300000, guid: bdaa38f00ae60c64e82c5bca5dc60a5c, type: 3}
  portraitFrameRate: 4
  dialogue:
  - text: "H\u1EA1o nh\xECn s\xE2u v\xE0o m\u1EAFt Kh\u1EA3i: \u201CTa c\xF3 th\u1EC3
      kh\xF3a V\xF4 Di\u1EC7n l\u1EA1i m\u1ED7i \u0111\xEAm, nh\u01B0ng con s\u1EBD
      ph\u1EA3i hi\u1EBFn m\u1ED9t m\u1EA3nh k\xFD \u1EE9c.\u201D"
    nextNodeIndex: 1
    choices: []
  - text: "H\u1EA1o \u0111\u1EB7t l\xE1 b\xF9a l\xEAn b\xE0n th\u1EDD. Kh\u1EA3i
      ph\u1EA3i ch\u1ECDn c\xF3 ch\u1EA5p nh\u1EADn c\xE1i gi\xE1 \u1EA5y hay kh\xF4ng."
    nextNodeIndex: -1
    choices:
    - sessionId: 3
      choiceId: A
      label: "\u0110\u1ED3ng \xFD d\xF9ng b\xF9a kh\xF3a qu\u1EF7."
      requiredFlag: Session3Ready
      resultText: "H\u1EA1o l\xE0m l\u1EC5 kh\xF3a qu\u1EF7. M\u1ED9t m\u1EA3nh k\xFD
        \u1EE9c c\u1EE7a Kh\u1EA3i tan bi\u1EBFn; \u0111\xEAm xu\u1ED1ng, anh nghe
        ti\u1EBFng g\u1ECDi trong m\u01A1."
      nextNodeIndex: 2
      ltDelta: 2
      qtDelta: -1
    - sessionId: 3
      choiceId: B
      label: "T\u1EEB ch\u1ED1i, t\u1EF1 t\xECm c\xE1ch kh\xE1c."
      requiredFlag: Session3Ready
      resultText: "Kh\u1EA3i t\u1EEB ch\u1ED1i hi\u1EBFn k\xFD \u1EE9c v\xE0 quy\u1EBFt
        \u0111\u1ECBnh t\u1EF1 \u0111\u1ED1i m\u1EB7t v\u1EDBi l\u1EDDi nguy\u1EC1n."
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 1
  - text: "Kh\u1EA3i bi\u1EBFt l\u1EF1a ch\u1ECDn n\xE0y s\u1EBD thay \u0111\u1ED5i
      con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc."
    nextNodeIndex: -1
    choices: []
