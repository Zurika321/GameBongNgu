--- !u!114 &628440071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 628440070}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e52977d2e9a792458bf7f522d39e7e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemoNpcDialogueProfile
  npcName: Mira
  portraitFrames:
  - {fileID: 21300000, guid: 4a7c373ffdfc6974f8b309260c7bd466, type: 3}
  - {fileID: 21300000, guid: bdaa38f00ae60c64e82c5bca5dc60a5c, type: 3}
  portraitFrameRate: 3
  dialogue:
  - text: Traveler, the roads around here have become dangerous. What would you like
      to know?
    nextNodeIndex: -1
    choices:
    - sessionId: 
      choiceId: 
      label: Who are you?
      requiredFlag: 
      resultText: I am Mira, a scout. I keep notes on the paths and ruins nearby.
      nextNodeIndex: 1
      ltDelta: 0
      qtDelta: 0
    - sessionId: 
      choiceId: 
      label: What is that marked area?
      requiredFlag: 
      resultText: Those outlines mark places worth exploring. The map updates around
        your position.
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 0
    - sessionId: 
      choiceId: 
      label: I should go.
      requiredFlag: 
      resultText: Stay safe out there. I will be here if you need a guide.
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
  - text: I watch the old crossing. Bring back a relic and I can tell you more about
      the ruins.
    nextNodeIndex: -1
    choices:
    - sessionId: 
      choiceId: 
      label: Tell me about the relic.
      requiredFlag: 
      resultText: Look for a small blue marker near the eastern edge of the map.
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 0
    - sessionId: 
      choiceId: 
      label: Back to the map.
      requiredFlag: 
      resultText: The eastern outline is the place I mentioned.
      nextNodeIndex: 2
      ltDelta: 0
      qtDelta: 0
  - text: The eastern ruins are quiet at first, but do not let your guard down.
    nextNodeIndex: -1
    choices:
    - sessionId: 
      choiceId: 
      label: Thanks for the warning.
      requiredFlag: 
      resultText: Anytime. Keep your health up and watch for openings.
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
    - sessionId: 
      choiceId: 
      label: Goodbye.
      requiredFlag: 
      resultText: Safe travels, traveler.
      nextNodeIndex: -1
      ltDelta: 0
      qtDelta: 0
